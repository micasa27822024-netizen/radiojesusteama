# Puerto del servidor (opcional)
PORT=3000

# Cloudinary (solo si vas a usar la función de saludos de audio)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=radio_saludos

# Clave para leer la lista de saludos (dejala vacía para acceso libre)
ADMIN_TOKEN=

# Cantidad máxima de saludos guardados en memoria
MAX_SALUDOS=100

# --- Chat de la iglesia (Firebase) ---
# Solo hacen falta para el script de limpieza automática (limpiar-chat.js)
FIREBASE_DB_URL=
FIREBASE_API_KEY=
MODERADOR_EMAIL=
MODERADOR_PASSWORD=

# Días de mensajes que se conservan al limpiar (por defecto 30)
DIAS_RETENCION=30

# Ruta del chat dentro de la base (por defecto chat/mensajes)
CHAT_RUTA=chat/mensajes
